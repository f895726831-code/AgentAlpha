# AgentAlpha Environment Configuration
# Copy this file to .env and fill in your API keys
#
#   cp env.example .env

# ─── Required ───

# DeepSeek API (LLM Compiler / Strategy compilation / TiMi adapter)
DEEPSEEK_API_KEY=

# ─── Optional ───

# Anthropic Claude API (Agent pipeline — can use DeepSeek as fallback)
ANTHROPIC_API_KEY=

# Wind Financial Terminal (A-share market data — requires Wind installation)
WIND_API_KEY=

# Tushare (A-share data — free tier available)
TUSHARE_TOKEN=

# Financial Modeling Prep (US/global market data)
FMP_API_KEY=

# Finviz (US market screener)
FINVIZ_API_KEY=

# iWencai (A-share stock screener)
IWENCAI_API_KEY=
