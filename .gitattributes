# Auto-detect text files, normalize line endings
* text=auto

# Shell scripts
*.sh text eol=lf

# PowerShell scripts (Windows native)
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Python
*.py text eol=lf

# TypeScript/JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.mjs text eol=lf

# Markdown
*.md text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Batch
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.exe binary
*.dll binary
